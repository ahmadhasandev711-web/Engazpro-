APP_NAME="EBMS - Engaz PRO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ebms.online

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

FRONTEND_URL=https://ebms.online
FRONTEND_URLS=https://ebms.online,https://www.ebms.online
SANCTUM_STATEFUL_DOMAINS=ebms.online,www.ebms.online,api.ebms.online

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=change_me_db_name
DB_USERNAME=change_me_db_user
DB_PASSWORD=change_me_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ebms.online

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must stay above the longest queued job timeout (WooCommerce/Shopify import/stock push: 900s).
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database

MAIL_MAILER=log

POS_TRIAL_DAYS=14
POS_ANNUAL_PRICE=3000.00
POS_ECOMMERCE_ADDON_PRICE=2000.00
POS_CURRENCY=EGP

# Optional Shopify Public App / Dev Dashboard defaults
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Set a strong random secret before using /api/ops/maintenance-sync-7b3e9a
DEPLOY_SYNC_SECRET=
